# ~/.config/sinter/bridge.env — read by sinter-bridge.service (chmod 600).
# Absolute paths only: systemd does not expand ~ or $HOME in this file.
SINTER_BRIDGE_GATEWAY_URL=https://gateway.fulltrust.co.jp
SINTER_BRIDGE_CREDENTIAL_FILE=/home/USER/.config/sinter/bridge.cred
# The systemd user PATH does not include ~/.local/bin (where install.sh puts
# sinter), so point at the binary explicitly:
SINTER_BRIDGE_SINTER_BIN=/home/USER/.local/bin/sinter
# Optional: named SSH targets for sinter_plan_host / sinter_audit_host
#SINTER_BRIDGE_TARGETS_FILE=/home/USER/.config/sinter/targets.toml
#SINTER_BRIDGE_LOG=info
