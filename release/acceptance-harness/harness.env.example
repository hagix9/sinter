# Release acceptance harness configuration (copy outside the repository, fill
# in, and `set -a; . <file>; set +a` before running). Every value is required;
# the harness has no defaults for anything environment- or release-specific.

SINTER_PROJECT=<gcp-project-id>
SINTER_ZONE=<gcp-zone>
# One target per line: <instance>:<label>:<need_ip yes|no>:<make_cache yes|no>
SINTER_SPECS="<instance>:ubuntu2404:no:no
<instance>:rocky9:no:no"
SINTER_ARTIFACT=/path/to/sinter-v<version>-linux-x86_64.tar.gz
SINTER_RC_COMMIT=<40-hex release-candidate commit>
SINTER_EXP_ART=<64-hex SHA-256 of the tarball>
SINTER_EXP_EXE=<64-hex SHA-256 of the sinter executable in the tarball>
SINTER_EXP_VER="sinter <version>"
# Optional, local and untracked: extra <regex><TAB><replacement> lines to mask
# in the published logs (the project, zone and instance names above are always
# masked).
SINTER_SANITIZE_PATTERNS=/path/outside/the/repository/sanitize-patterns.tsv
