{
  "schema": "sinter-acceptance-manifest/1",
  "candidate": {
    "version": "<X.Y.Z>",
    "tag": "<vX.Y.Z>",
    "source_commit": "<40-hex RC commit>",
    "artifact": {
      "filename": "<sinter-vX.Y.Z-linux-x86_64.tar.gz>",
      "sha256": "<64-hex tarball sha256>",
      "size_bytes": 0
    },
    "executable_sha256": "<64-hex sha256 of the frozen sinter executable>",
    "build": {
      "baseline": "<build OS and version, e.g. Rocky Linux 9.x x86_64>",
      "rustc": "<rustc --version>",
      "max_glibc": "<e.g. GLIBC_2.34>"
    }
  },
  "harness": {
    "name": "<harness name>",
    "version": "<harness version or commit>",
    "files": [
      { "path": "<harness/relative/path>", "sha256": "<64-hex>" }
    ],
    "runner": "<runner command with <target-label> placeholders, no hostnames or IPs>",
    "operator": "<role, e.g. release maintainer>"
  },
  "run": {
    "started_at": "<RFC 3339 UTC, e.g. 2026-01-01T00:00:00Z>",
    "finished_at": "<RFC 3339 UTC>"
  },
  "targets": [
    {
      "label": "<target-label, e.g. rocky9>",
      "os_name": "<NAME from /etc/os-release>",
      "os_version": "<VERSION_ID or point release>",
      "arch": "<uname -m>",
      "image": "<public image family and version>",
      "started_at": "<RFC 3339 UTC>",
      "finished_at": "<RFC 3339 UTC>",
      "artifact_sha256": "<64-hex observed on the target>",
      "executable_sha256": "<64-hex observed on the target>",
      "version_output": "<sinter X.Y.Z>",
      "checks": { "total": 0, "passed": 0, "failed": 0, "skipped": 0 },
      "verdict": "<PASS or FAIL>",
      "log": { "path": "<logs/target-label.log>", "sha256": "<64-hex>" }
    }
  ],
  "totals": { "targets": 0, "total": 0, "passed": 0, "failed": 0, "skipped": 0 },
  "verdict": "<GO or NO-GO>",
  "evidence_bundle": "<sinter-vX.Y.Z-acceptance-evidence.tar.gz>"
}
