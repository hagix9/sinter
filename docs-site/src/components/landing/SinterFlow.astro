---
interface Props {
  recipeLabel: string;
  recipeSub: string;
  declareLabel: string;
  sinterLabel: string;
  sinterSub: string;
  sshLabel: string;
  observeLabel: string;
  convergeLabel: string;
  targetLabel: string;
  targetSub: string;
  planSub: string;
  applySub: string;
  auditSub: string;
  note: string;
  pauseLabel: string;
  playLabel: string;
}
const p = Astro.props;
---

<div class="flow">
  <button
    type="button"
    class="flow-toggle"
    aria-label={p.pauseLabel}
    data-label-pause={p.pauseLabel}
    data-label-play={p.playLabel}
    hidden
  >
    <span class="flow-toggle-icon" aria-hidden="true">❚❚</span>
  </button>
  <ol class="flow-main">
    <li class="f-node">
      <strong>{p.recipeLabel}</strong>
      <span class="f-sub">{p.recipeSub}</span>
    </li>
    <li class="f-edge e-declare">
      <span class="f-edge-label">{p.declareLabel}</span>
      <i class="f-pulse p-declare" aria-hidden="true"></i>
    </li>
    <li class="f-node f-sinter">
      <strong>{p.sinterLabel}</strong>
      <span class="f-sub">{p.sinterSub}</span>
    </li>
    <li class="f-edge e-ssh">
      <span class="f-edge-label">{p.sshLabel}</span>
      <span class="f-dir f-dir-observe"><b aria-hidden="true">&larr;</b>{p.observeLabel}</span>
      <span class="f-dir f-dir-converge">{p.convergeLabel}<b aria-hidden="true">&rarr;</b></span>
      <i class="f-pulse p-out" aria-hidden="true"></i>
      <i class="f-pulse p-back" aria-hidden="true"></i>
      <i class="f-pulse p-conv" aria-hidden="true"></i>
      <i class="f-pulse p-audit" aria-hidden="true"></i>
    </li>
    <li class="f-node">
      <strong>{p.targetLabel}</strong>
      <span class="f-sub">{p.targetSub}</span>
    </li>
  </ol>
  <ul class="flow-modes" aria-label="Sinter modes">
    <li class="f-mode">
      <strong>PLAN</strong>
      <span class="f-sub">{p.planSub}</span>
    </li>
    <li class="f-mode f-apply">
      <strong>APPLY</strong>
      <span class="f-sub">{p.applySub}</span>
    </li>
    <li class="f-mode">
      <strong>AUDIT</strong>
      <span class="f-sub">{p.auditSub}</span>
    </li>
  </ul>
  <p class="flow-note">{p.note}</p>
</div>

<script>
  // Pause / Play for the flow animation. Play restarts the cycle from the
  // beginning. The button stays hidden without JS and under reduced motion
  // (see landing.css), where the diagram is already static.
  for (const flow of document.querySelectorAll<HTMLElement>('.flow')) {
    const button = flow.querySelector<HTMLButtonElement>('.flow-toggle');
    const icon = button?.querySelector('.flow-toggle-icon');
    if (!button || !icon) continue;
    const { labelPause = 'Pause', labelPlay = 'Play' } = button.dataset;
    button.hidden = false;
    button.addEventListener('click', () => {
      const paused = flow.classList.toggle('is-paused');
      if (!paused) {
        for (const a of flow.getAnimations({ subtree: true })) a.currentTime = 0;
      }
      button.setAttribute('aria-label', paused ? labelPlay : labelPause);
      icon.textContent = paused ? '▶' : '❚❚';
    });
  }
</script>
