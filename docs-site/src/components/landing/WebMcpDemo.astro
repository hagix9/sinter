---
interface Props {
  askLabel: string;
  question: string;
  toolLabel: string;
  tool: string;
  answerLabel: string;
  answer: string;
}
const { askLabel, question, toolLabel, tool, answerLabel, answer } = Astro.props;
---

<div class="wm-demo">
  <div class="wm-row wm-q">
    <span class="wm-label">{askLabel}</span>
    <p class="wm-text">{question}</p>
  </div>
  <div class="wm-row wm-step">
    <span class="wm-label">{toolLabel}</span>
    <p class="wm-text"><code class="wm-tool">{tool}</code></p>
  </div>
  <div class="wm-row wm-a">
    <span class="wm-label">{answerLabel}</span>
    <p class="wm-text">{answer}</p>
  </div>
</div>
