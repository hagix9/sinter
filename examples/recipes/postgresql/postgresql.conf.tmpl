# Managed by Sinter (examples/recipes/postgresql-os.yaml). Settings not listed
# keep PostgreSQL's built-in defaults; add your own in conf.d/.
listen_addresses = 'localhost'
port = {{ vars.port }}
max_connections = 100
shared_buffers = 128MB
dynamic_shared_memory_type = posix
password_encryption = scram-sha-256
logging_collector = on
log_directory = 'log'
log_filename = 'postgresql-%a.log'
log_rotation_age = 1d
log_rotation_size = 0
log_truncate_on_rotation = on
log_line_prefix = '%m [%p] '
log_timezone = 'UTC'
datestyle = 'iso, mdy'
timezone = 'UTC'
lc_messages = 'C'
lc_monetary = 'C'
lc_numeric = 'C'
lc_time = 'C'
default_text_search_config = 'pg_catalog.english'
# Absolute, so the file also validates from its staging location.
include_dir = '{{ vars.datadir }}/conf.d'
